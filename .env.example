# Backend preparation: demo is the only implemented app adapter.
# Any other mode shows an integration-pending screen.
# Local real-data development workspaces: /?authSetup=1 and /?requirementsTest=1.
VITE_BACKEND_MODE=demo
# Only VITE_ variables are exposed to the browser. Keep all secrets below without that prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Display hint only: preview uses Mailpit; smtp means Auth delivery was configured.
# This does not configure Supabase SMTP or grant account access.
VITE_AUTH_EMAIL_DELIVERY=preview

# Legacy MySQL prototype only. Supabase replaces this path.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pup_intrack
API_PORT=3001
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM="InTrack - OJT Monitoring System <your_verified_sender@example.com>"

# Server-only shared initial password for newly whitelisted students/advisers.
INTRACK_DEFAULT_PASSWORD=

# Local operator API credentials. Use the local SERVICE_ROLE_KEY or sb_secret_ key, not JWT_SECRET.
INTRACK_OPERATOR_SUPABASE_URL=http://127.0.0.1:54321
INTRACK_OPERATOR_SECRET_KEY=
# Optional recovery test target: a separate local Supabase instance/API port.
INTRACK_RESTORE_SUPABASE_URL=
INTRACK_RESTORE_SECRET_KEY=

# Supabase Auth SMTP credentials. The password is the provider's SMTP key.
INTRACK_AUTH_SMTP_PASSWORD=
INTRACK_AUTH_SMTP_USER=
INTRACK_AUTH_SMTP_SENDER=
